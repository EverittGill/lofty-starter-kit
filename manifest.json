{
  "manifest_version": 3,
  "name": "KTS Drips to Lofty",
  "version": "1.0.0",
  "description": "Uploads the KTS email drips to your Lofty account as draft Smart Plans",
  "permissions": [
    "storage",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://crm.lofty.com/*",
    "https://*.lofty.com/*"
  ],
  "action": {
    "default_title": "KTS Drips to Lofty"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.lofty.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "data/templates.json",
        "data/action-plans.json"
      ],
      "matches": [
        "https://crm.lofty.com/*"
      ]
    }
  ]
}